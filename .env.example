# ── Required ─────────────────────────────────────────────────────────────

# MySQL connection string for the dashboard's data (users, courses,
# progress, tasks, study sessions, etc.). Any reachable MySQL 8+ instance
# works — e.g. PlanetScale, Railway, RDS, or a local `mysql` container.
DATABASE_URL="mysql://user:password@host:3306/neura"

# Secret used to sign session cookies (login/signup issue a JWT signed with
# this). Use a long, random, unguessable string — e.g. `openssl rand -hex 32`.
JWT_SECRET="replace-with-a-long-random-secret"

# ── Optional ─────────────────────────────────────────────────────────────

# Free-form identifier stored in the session JWT payload. Not required for
# auth to work; only useful if you want to distinguish this deployment's
# tokens from another app's.
VITE_APP_ID="neura"

# openId of a user who should be treated as an owner/admin by
# server/routers.ts's `ownerProcedure`. Leave unset if you don't need an
# admin role yet.
OWNER_OPEN_ID=""

# Only needed if you want the optional `/manus-storage/*` file-proxy route
# (server/_core/storageProxy.ts) to work. It proxies reads through a
# "Forge"-compatible presigned-URL storage API. Nothing in the live
# dashboard currently calls this route, so it's safe to leave unset.
BUILT_IN_FORGE_API_URL=""
BUILT_IN_FORGE_API_KEY=""

# Port the Express server listens on. Defaults to 3000 if unset (see
# server/_core/index.ts).
PORT=3000
